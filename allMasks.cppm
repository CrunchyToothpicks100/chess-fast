export enum PieceType : uint8_t { Rook, Knight, Bishop, Queen, King, Pawn };

export constexpr const uint64_t *maskPiece(int8_t type, int8_t pos) {
  static_assert(sizeof(knightMasks) == 64 * sizeof(uint64_t));
  static_assert(sizeof(rookMasks) == 64 * sizeof(uint64_t));
  static_assert(sizeof(kingMasks) == 64 * sizeof(uint64_t));
  switch (type) {
  case PieceType::Rook:
    return &rookMasks[pos];
  case PieceType::Knight:
    return &knightMasks[pos];
  case PieceType::King:
    return &kingMasks[pos];
  default:
    return 0;
  }
}
